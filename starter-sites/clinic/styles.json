{
	"version": 3,
	"settings": {
		"typography": {
			"fontSizes": [
				{
					"name": "Small",
					"slug": "small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.375rem",
					"fluid": {
						"min": "1.2rem",
						"max": "1.375rem"
					}
				},
				{
					"name": "Extra Large",
					"slug": "x-large",
					"size": "2rem",
					"fluid": {
						"min": "1.6rem",
						"max": "2rem"
					}
				},
				{
					"name": "Extra Extra Large",
					"slug": "xx-large",
					"size": "2.75rem",
					"fluid": {
						"min": "2rem",
						"max": "2.75rem"
					}
				},
				{
					"name": "Huge",
					"slug": "huge",
					"size": "3.75rem",
					"fluid": {
						"min": "2.4rem",
						"max": "3.75rem"
					}
				}
			]
		},
		"spacing": {
			"spacingSizes": [
				{
					"name": "1",
					"slug": "10",
					"size": "0.5rem"
				},
				{
					"name": "2",
					"slug": "20",
					"size": "0.75rem"
				},
				{
					"name": "3",
					"slug": "30",
					"size": "1rem"
				},
				{
					"name": "4",
					"slug": "40",
					"size": "1.5rem"
				},
				{
					"name": "5",
					"slug": "50",
					"size": "clamp(1.5rem, 4vw, 2.25rem)"
				},
				{
					"name": "6",
					"slug": "60",
					"size": "clamp(2rem, 5vw, 3.5rem)"
				},
				{
					"name": "7",
					"slug": "70",
					"size": "clamp(2.5rem, 7vw, 5rem)"
				},
				{
					"name": "8",
					"slug": "80",
					"size": "clamp(3.5rem, 9vw, 7rem)"
				}
			]
		}
	},
	"styles": {
		"css": ":where(.wp-site-blocks) > footer{margin-block-start:0}",
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|contrast"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|heading",
					"fontWeight": "650",
					"lineHeight": "1.15",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button, 999px)"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.5rem",
						"bottom": "0.8rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|40"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|muted"
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30"
					}
				}
			}
		}
	}
}
